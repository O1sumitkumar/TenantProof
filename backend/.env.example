# Copy to backend/.env for local `uv run` commands:  cp backend/.env.example backend/.env
# docker compose does NOT read this file for the api container; it sets its own environment in
# docker-compose.yml. Compose reads a root-level .env only to substitute ${VARS} (for example
# SEED_PASSWORD and POSTGRES_HOST_PORT). Never commit a real .env.

# --- Database and cache (defaults match `make up`: Postgres on host port 5433) ---
DATABASE_URL=postgresql+psycopg://tenantproof:tenantproof@localhost:5433/tenantproof
REDIS_URL=redis://localhost:6379/0
# Host port compose publishes Postgres on (5432 is often taken by a local Postgres).
POSTGRES_HOST_PORT=5433

# --- LLM (live mode lands in M3; tests and CI always use fixture) ---
LLM_MODE=fixture
# Not used by the code yet. Leave empty here; never commit a real key.
ANTHROPIC_API_KEY=

# --- Web and links ---
PUBLIC_BASE_URL=http://localhost:8000
WEB_DIR=../web
INTAKE_TOKEN_TTL_DAYS=14

# --- Auth ---
# Secure cookie flag. true everywhere except plain-http localhost (compose sets false).
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
# Password for the two seeded demo caseworkers. Demo only: pick your own for anything shared.
SEED_PASSWORD=change-me-demo-only

# --- Rate limits (slowapi; counters in Redis) ---
LOGIN_RATE_LIMIT=10/minute
SUBMIT_RATE_LIMIT=20/minute
# Empty = use REDIS_URL. Tests set redis://localhost:6379/1 (a separate Redis db).
RATE_LIMIT_STORAGE_URI=

# --- Evidence uploads ---
# Per-file cap in bytes (25 MB), and a rate limit per client IP on both upload routes.
MAX_UPLOAD_BYTES=26214400
UPLOAD_RATE_LIMIT=30/minute

# --- Blob storage (package zips, original evidence files, stripped copies) ---
STORAGE_DIR=./data/storage

# --- Tests only ---
# Suffix for the throwaway test database (tenantproof_test<suffix>) so parallel runs don't collide.
TEST_DB_SUFFIX=

# --- Desktop shell (desktop/): the app URL it loads. http(s) only. ---
APP_URL=http://localhost:8000
